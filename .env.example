# ===========================
# ORIGEN Hub - Environment Variables
# ===========================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Supabase ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Google Maps ---
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# --- Payments ---
# "mock" = direct DB writes (no Stripe required)
# "stripe" = real Stripe Connect checkout
VITE_PAYMENT_MODE=mock

# --- Site URL (for canonical, OG tags, emails) ---
VITE_SITE_URL=https://www.ritmorigen.com
